# Supabase Configuration
# Get these values from your Supabase project dashboard:
# 1. Go to https://supabase.com/dashboard/project/YOUR_PROJECT_ID/settings/api
# 2. Copy the "Project URL" and "anon public" key (the long JWT token starting with "eyJ")

VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_public_key_here

# Optional: Cloudinary (unsigned upload preset). Leave empty to use Supabase Storage.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
